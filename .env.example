# Kopieer dit bestand naar .env en vul in.  (nano .env)

# Image die op Hostinger gebruikt wordt (gebouwd door GitHub Actions bij elke push op main)
STUDIO_IMAGE=ghcr.io/nickb-vtiz/studio:latest

# Wachtwoord om in te loggen in Studio (minstens 8 tekens; kies iets lang en uniek)
ADMIN_PASSWORD=verander-dit-wachtwoord

# Geheime sleutel voor de login-cookie: een lange willekeurige tekst (maak er een met: openssl rand -hex 32)
SESSION_SECRET=vul-hier-een-lange-willekeurige-tekst-in

# Publieke basis-URL die in mails en in de app getoond wordt
BASE_URL=https://studio.justpixit.be

# Token voor de "Laad nieuwe versie"-knop (Watchtower). Een lange willekeurige tekst: openssl rand -hex 24
# Laat je dit leeg, dan werkt de app wel, maar is de updateknop uitgeschakeld.
UPDATE_TOKEN=vul-hier-een-lange-willekeurige-tekst-in

# ---- Mail (optioneel). Zonder deze regels worden er geen bevestigingsmails gestuurd; boeken werkt wel. ----
# Kies ÉÉN manier: Resend (aanbevolen, eenvoudig) OF SMTP.
#
# Resend (https://resend.com): maak een API-sleutel aan en verifieer je domein of afzender.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=justPIXIT <info@justpixit.be>
#
# of SMTP (bv. Hostinger e-mail):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@justpixit.be
# SMTP_PASS=wachtwoord-van-je-mailbox
# SMTP_FROM=justPIXIT <info@justpixit.be>
#
# ADMIN_EMAIL=info@justpixit.be   # waar de melding van een nieuwe boeking naartoe gaat (standaard: de afzender)

# ---- WhatsApp via Twilio (optioneel) ----
# Maak een Twilio-account, activeer een WhatsApp-afzender en keur je templates goed.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+32470000000   # jouw goedgekeurde WhatsApp-afzendernummer

